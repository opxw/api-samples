{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpxApiProtection": {
    "SecurityHeaders": {
      "Enabled": true,
      "ReferrerPolicy": "no-referrer",
      "FrameOptions": "DENY"
    },
    "RateLimiting": {
      "Enabled": true,
      "Algorithm": "FixedWindow",
      "Limit": 120,
      "WindowSeconds": 60,
      "CleanupIntervalSeconds": 60,
      "WriteHeadersOnSuccess": false,
      "PathPrefixes": [
        "/api",
        "/artists",
        "/albums",
        "/genres"
      ]
    },
    "SuspiciousTraffic": {
      "Enabled": true,
      "Block": true,
      "StatusCode": 400,
      "BlockedResponseMode": "WrappedFast",
      "RegexTimeoutMilliseconds": 100,
      "ExcludedPathPrefixes": [
        "/health",
        "/openapi",
        "/swagger",
        "/favicon.ico",
        "/assets",
        "/static"
      ],
      "AllowedIpAddresses": [
        "127.0.0.1",
        "::1",
        "10.0.0.0/8",
        "192.168.1.0/24"
      ],
      "DeniedIpAddresses": [],
      "Patterns": [
        "sqlmap",
        ".env",
        ".git",
        "union select",
        "information_schema",
        "<script",
        "../",
        "xp_cmdshell",
        "or 1=1",
        "drop table"
      ]
    },
    "AuthorizationGuard": {
      "Enabled": false,
      "ExcludedPathPrefixes": [
        "/health",
        "/swagger",
        "/openapi"
      ],
      "WhitelistedPathPrefixes": [
        "/health",
        "/swagger",
        "/openapi",
        "/public"
      ]
    },
    "AccessLog": {
      "Enabled": true,
      "Output": "Both",
      "FilePath": "logs/access-log-{date}.log",
      "QueueCapacity": 8192,
      "BatchSize": 100,
      "FlushIntervalMilliseconds": 250
    },
    "SecurityIssueLog": {
      "Enabled": true,
      "Output": "File",
      "FilePath": "logs/security-issue-log-{date}.log",
      "Format": "JsonLines",
      "SampleRate": 10,
      "MaxPathLength": 512,
      "MaxQueryLength": 512,
      "MaxHeaderLength": 512,
      "MaxReasonLength": 256,
      "QueueCapacity": 8192,
      "BatchSize": 100,
      "FlushIntervalMilliseconds": 250
    },
    "LogApi": {
      "Enabled": true,
      "RoutePrefix": "/opx/framework/logs",
      "AccessLogId": "access",
      "SecurityLogId": "security",
      "RequireAuthorization": false,
      "RequiredRole": "",
      "RequiredPolicy": ""
    },
    "MetricsApi": {
      "Enabled": true,
      "RequireAuthorization": false,
      "RequiredRole": "",
      "RequiredPolicy": ""
    },
    "Validation": {
      "FailFast": false
    },
    "Policies": [
      {
        "PathPrefix": "/public",
        "SkipAuthorization": true,
        "SkipRateLimiting": true,
        "SkipSuspiciousTraffic": false
      },
      {
        "PathPrefix": "/api/heavy",
        "RateLimit": 500,
        "RateLimitWindowSeconds": 60
      }
    ]
  },
  "OpxEndpointProxy": {
    "Enabled": true,
    "Mode": "Rewrite",
    "RouteMapPath": "App_Data/opx-endpoint-routes.json",
    "AllowedAliasPrefixes": [
      "/gw",
      "/_sys"
    ],
    "FailOnConflict": true
  },
  "EndpointLog": {
    "Enabled": true,
    "IncludeQueryString": true,
    "IncludeRouteValues": true,
    "IncludeRequestBody": false,
    "IncludeResponseBody": false,
    "IncludeCurl": true,
    "Output": "Logger",
    "ResponseBodyMode": "Auto",
    "MaskSensitiveValues": true,
    "MaxBodyLength": 4000,
    "SensitiveKeys": [
      "password",
      "token",
      "secret",
      "authorization"
    ]
  },
  "AllowedHosts": "*"
}
